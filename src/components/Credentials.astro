---
// Certificates and licenses (site.credentials): only real ones the client has sent,
// each with the body that issued it and proof (a link to the public record or a
// scan in public/photos/). Hidden until the first one exists. Feeds hasCredential
// in the LocalBusiness schema.
import { loadContent } from '../lib/content.mjs';
const { heading, intro, alt = false } = Astro.props;
const { site } = loadContent();
const list = site.credentials ?? [];
---
{list.length > 0 && (
  <section class={`section ${alt ? 'section-alt' : ''}`}>
    <div class="wrap">
      <h2>{heading ?? site.credentialsHeading ?? 'Certificates and Licenses'}</h2>
      {(intro ?? site.credentialsIntro) && <p class="lead">{intro ?? site.credentialsIntro}</p>}
      <ul class="creds">
        {list.map((c) => (
          <li class="card cred">
            {c.image?.src
              ? <img class="cred-img" src={c.image.src} alt={c.image.alt ?? `${c.name} from ${c.issuer}`} width={c.image.width ?? 160} height={c.image.height ?? 160} loading="lazy" decoding="async" />
              : <span class="cred-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4-6.3 6.3Z"/></svg></span>}
            <div>
              <p class="cred-name">{c.name}</p>
              <p class="cred-issuer">{c.issuer}{c.number && <> · {c.number}</>}</p>
              {c.verifyUrl && <p class="cred-verify"><a href={c.verifyUrl} target="_blank" rel="noopener">Check the {c.issuer} record</a></p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .creds{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
  .cred{display:flex;gap:14px;align-items:flex-start;padding:18px}
  .cred-img{width:64px;height:64px;object-fit:contain;flex:none}
  .cred-mark{flex:none;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--c-primary) 10%,#fff);color:var(--c-primary)}
  .cred-name{font-weight:700;margin:0 0 4px;color:var(--c-heading,var(--c-primary))}
  .cred-issuer{margin:0;color:var(--c-muted);font-size:.92rem}
  .cred-verify{margin:8px 0 0;font-size:.92rem}
</style>
