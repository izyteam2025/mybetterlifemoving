---
// Google rating badge: stars, rating and count from site.json (refreshed from the GBP
// at every release), linking to the real reviews on Google.
import { loadContent } from '../lib/content.mjs';
const { site } = loadContent();
const url = site.googleReviewsUrl ?? site.gbpUrl;
const r = site.rating;
---
{r?.value && (
  <a class="rating-badge" href={url} target="_blank" rel="noopener">
    <svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.7-2.1 5-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.1z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.5-3.8-12.2-9H4.5v5.7C8.1 41.1 15.5 46 24 46z"/><path fill="#FBBC05" d="M11.8 28.3c-.4-1.3-.7-2.7-.7-4.3s.3-3 .7-4.3V14H4.5C3 17 2 20.4 2 24s1 7 2.5 10l7.3-5.7z"/><path fill="#EA4335" d="M24 10.7c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.1 29.9 2 24 2 15.5 2 8.1 6.9 4.5 14l7.3 5.7c1.7-5.2 6.5-9 12.2-9z"/></svg>
    <span class="rb-stars" aria-hidden="true">★★★★★</span>
    <span class="rb-text"><strong>{r.value}</strong> from {r.count}+ Google reviews</span>
  </a>
)}
<style>
  .rating-badge{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #E3E6EA;border-radius:999px;padding:7px 14px;text-decoration:none;color:var(--c-text);font-size:.92rem;box-shadow:0 4px 14px rgba(0,0,0,.06);margin-bottom:14px}
  .rb-stars{color:#F4B400;letter-spacing:1px}
</style>
