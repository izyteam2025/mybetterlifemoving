---
// Partners (site.partners): companies the client really works with (home warranty
// companies, property managers, parts suppliers, associations), with their logo only
// when the partner allows it. Hidden until the first one exists. Manufacturer brands
// are not partners: they go in site.brandsWeRepair (the brands block).
import { loadContent } from '../lib/content.mjs';
const { heading, intro, alt = false } = Astro.props;
const { site } = loadContent();
const list = site.partners ?? [];
---
{list.length > 0 && (
  <section class={`section partners ${alt ? 'section-alt' : ''}`}>
    <div class="wrap center">
      <h2>{heading ?? site.partnersHeading ?? 'Our Partners'}</h2>
      {(intro ?? site.partnersIntro) && <p class="lead">{intro ?? site.partnersIntro}</p>}
      <ul class="plist">
        {list.map((p) => {
          const inner = p.logo?.src
            ? <img src={p.logo.src} alt={p.logo.alt ?? p.name} width={p.logo.width ?? 160} height={p.logo.height ?? 60} loading="lazy" decoding="async" />
            : <span class="pname"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12.2 5.3 9.7 3a2.4 2.4 0 0 0-3.3 0L2.7 6.7a2.4 2.4 0 0 0 0 3.4l.9.9 4.9-4.9 1.8 1.7Zm9.1 1.4L17.6 3a2.4 2.4 0 0 0-3.3 0L8 9.3a1.6 1.6 0 0 0 2.3 2.3l3.1-3.1 6.3 6.3 1.6-1.6a2.4 2.4 0 0 0 0-3.4ZM12.6 9.8l-1.2 1.2a3.2 3.2 0 0 1-4.5-4.5l.5-.5-3.3 3.3 7.9 8a1.4 1.4 0 0 0 2-2l.6.6a1.4 1.4 0 0 0 2-2l.4.4a1.4 1.4 0 0 0 2-2Z"/></svg>{p.name}</span>;
          return (
            <li class="card pcard" title={p.note ?? p.name}>
              {p.url ? <a href={p.url} target="_blank" rel="noopener" aria-label={p.logo?.src ? p.name : undefined}>{inner}</a> : inner}
              {p.note && <span class="pnote">{p.note}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
<style>
  .plist{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:14px;justify-content:center}
  .pcard{min-width:170px;min-height:84px;padding:14px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
  .pcard img{max-height:48px;width:auto;max-width:160px;object-fit:contain}
  .pname{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--c-primary)}
  .pname svg{flex:none;color:var(--c-accent,var(--c-primary))}
  .pnote{color:var(--c-muted);font-size:.85rem}
  .pcard a{text-decoration:none}
</style>
