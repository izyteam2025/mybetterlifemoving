---
// Social profiles as icon buttons (agency rule, 28 Oct 2026: every site shows its
// profiles with icons so it looks live). Sources: site.gbpUrl (Google) + site.sameAs.
// The network is read from each URL's host; unknown hosts get a generic link icon.
import { loadContent } from '../lib/content.mjs';
const { variant = 'dark', heading } = Astro.props;
const { site } = loadContent();
const NET = [
  ['google', /(^|\.)google\.|maps\.app\.goo\.gl|g\.page/, 'Google'],
  ['facebook', /facebook\.com|fb\.com/, 'Facebook'],
  ['instagram', /instagram\.com/, 'Instagram'],
  ['youtube', /youtube\.com|youtu\.be/, 'YouTube'],
  ['yelp', /yelp\./, 'Yelp'],
  ['tiktok', /tiktok\.com/, 'TikTok'],
  ['linkedin', /linkedin\.com/, 'LinkedIn'],
  ['x', /(^|\.)x\.com|twitter\.com/, 'X'],
  ['nextdoor', /nextdoor\.com/, 'Nextdoor'],
  ['pinterest', /pinterest\./, 'Pinterest'],
];
const urls = [site.gbpUrl, ...(site.sameAs ?? [])].filter(Boolean);
const items = [...new Set(urls)].map((u) => {
  let host = ''; try { host = new URL(u).hostname; } catch { return null; }
  const hit = NET.find(([, re]) => re.test(host));
  return { url: u, key: hit?.[0] ?? 'link', name: hit?.[2] ?? host.replace(/^www\./, '') };
}).filter(Boolean);
---
{items.length > 0 && (
  <div class={`socials socials-${variant}`}>
    {heading && <p class="socials-h">{heading}</p>}
    <ul>
      {items.map((it) => (
        <li><a href={it.url} target="_blank" rel="noopener" aria-label={`${site.name} on ${it.name}`} title={it.name} class={`si si-${it.key}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            {it.key === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor"/></>}
            {it.key === 'facebook' && <path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.5V21z"/>}
            {it.key === 'youtube' && <><rect x="2" y="5.5" width="20" height="13" rx="4" fill="currentColor"/><path d="M10 9v6l5.2-3z" fill="var(--si-bg, #fff)"/></>}
            {it.key === 'google' && <path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.5l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zM6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9zM12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5l3.3 2.6C7.2 7.8 9.4 6 12 6z"/>}
            {it.key === 'yelp' && <path fill="currentColor" d="M10.8 2.6c.9-.2 1.7.4 1.7 1.3v7.2c0 1-1.2 1.4-1.8.7L6 6.3c-.6-.6-.3-1.6.5-1.9 1.3-.8 2.8-1.5 4.3-1.8zm2.9 10.7 4.9 1.6c.8.3 1 1.3.4 1.9a8.7 8.7 0 0 1-2.4 2.3c-.7.4-1.6 0-1.8-.8l-1.5-4.9c-.2-.7.5-1.3 1.2-1.1zm-1.4.7c.6.4.6 1.3 0 1.7l-4.2 3c-.7.4-1.6.1-1.8-.7-.3-1.1-.4-2.3-.2-3.5.1-.8 1-1.2 1.7-.9zm1.6-2.4 3.1-4.1c.5-.7 1.5-.6 1.9.1.6 1.1 1 2.3 1.1 3.5 0 .8-.7 1.4-1.5 1.2l-4-.9c-.8-.2-1.1-1.1-.6-1.8z"/>}
            {it.key === 'tiktok' && <path fill="currentColor" d="M16.5 3c.4 2 1.7 3.4 3.5 3.6v3a7 7 0 0 1-3.5-1v6.3a5.9 5.9 0 1 1-5.9-5.9h.6v3.1a2.8 2.8 0 1 0 2.2 2.8V3z"/>}
            {it.key === 'linkedin' && <path fill="currentColor" d="M4.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 9h3v12H3zm6 0h2.9v1.7c.4-.8 1.4-1.9 3.3-1.9 3.2 0 3.8 2.1 3.8 4.8V21h-3v-6.6c0-1.6 0-3.5-2.2-3.5s-2.5 1.7-2.5 3.4V21H9z"/>}
            {it.key === 'x' && <path fill="currentColor" d="M17.5 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5 21H2l7.3-8.4L1.6 3H8l4.4 5.9zm-1.1 16.2h1.7L7.2 4.7H5.4z"/>}
            {it.key === 'nextdoor' && <path fill="currentColor" d="M12 3.5 2.5 11h3v9.5h5v-6h3v6h5V11h3z"/>}
            {it.key === 'pinterest' && <path fill="currentColor" d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.8-2.5.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.6 2.2-4.6 4.4 0 .9.3 1.8.8 2.3l.1.4-.3 1.1c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2z"/>}
            {it.key === 'link' && <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>}
          </svg>
          <span class="si-name">{it.name}</span>
        </a></li>
      ))}
    </ul>
  </div>
)}
<style>
  .socials ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
  .socials-h{font-weight:700;margin:0 0 8px}
  .si{display:inline-flex;align-items:center;gap:8px;padding:8px 12px 8px 10px;border-radius:999px;text-decoration:none;font-weight:600;font-size:.9rem;transition:transform .15s ease}
  .si:hover{transform:translateY(-1px)}
  .socials-dark .si{--si-bg:var(--c-footer);background:rgba(255,255,255,.12);color:#fff}
  .socials-dark .si:hover{background:rgba(255,255,255,.22)}
  .socials-light .si{--si-bg:#fff;background:#fff;border:1px solid #E3E6EA;color:var(--c-primary)}
  .socials-light .si-instagram{color:#C13584}.socials-light .si-facebook{color:#1877F2}.socials-light .si-youtube{color:#FF0000}.socials-light .si-google{color:#1A73E8}.socials-light .si-yelp{color:#D32323}.socials-light .si-linkedin{color:#0A66C2}.socials-light .si-nextdoor{color:#00B246}.socials-light .si-pinterest{color:#E60023}.socials-light .si-tiktok,.socials-light .si-x{color:#111}
</style>
