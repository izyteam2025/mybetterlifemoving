---
// Homepage (homepage-copy). Links: services hub + every main service page,
// service area hub + every main city page, brand pages (brand clients),
// About, Blog, FAQ, Reviews, conversion page. Never a city service page.
import Hero from '../components/Hero.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Team from '../components/Team.astro';
import Video from '../components/Video.astro';
import Gallery from '../components/Gallery.astro';
import ClubBand from '../components/ClubBand.astro';
import BrandList from '../components/BrandList.astro';
import Credentials from '../components/Credentials.astro';
import Partners from '../components/Partners.astro';

import Numbers from '../components/Numbers.astro';
import Offers from '../components/Offers.astro';
import PriceBlock from '../components/PriceBlock.astro';
import Cards from '../components/Cards.astro';
import SymptomPicker from '../components/SymptomPicker.astro';
import Prose from '../components/Prose.astro';
import Reviews from '../components/Reviews.astro';
import Tiles from '../components/Tiles.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { loadContent, liveHref, isLive, ctaPath, faqCtaPath, h1For, livePosts, servedByMainPages } from '../lib/content.mjs';
import { routes } from '../lib/routes.mjs';

const { page } = Astro.props;
const c = page.copy;
const { site, services, cities, brands } = loadContent();

const serviceCards = services
  .map((s) => ({ title: s.name, text: c.serviceCards?.[s.slug] ?? s.summary, href: liveHref(routes.service(s.slug)), image: s.image }))
  .filter((x) => x.href);
if (c.notSureTile) serviceCards.push({ title: c.notSureTile.title, text: c.notSureTile.text, href: ctaPath() });
const brandCards = brands.map((b) => ({ title: b.name, text: b.scope, href: liveHref(routes.brand(b.slug)) })).filter((x) => x.href);
// The target city is this page (unless site.targetCityPages): its tile is plain text.
const cityTiles = cities.map((ci) => ({ label: ci.name, href: servedByMainPages(ci) ? null : liveHref(routes.city(ci.slug)) }));
const posts = livePosts().slice(0, 3).map((p) => ({ title: p.title, text: p.metaDescription, href: routes.blogPost(p.slug) }));
---
<Hero h1={h1For(page)} hero={c.hero} image={site.media?.hero} withForm={!site.media?.hero} eyebrow={c.hero.eyebrow ?? site.eyebrow} supportLine={c.hero.supportLine ?? site.supportLine} />
<Numbers />
<Offers offers={c.offers} heading={c.offersHeading} />
<PriceBlock />
<Cards heading={c.servicesBlock.h2} intro={c.servicesBlock.intro} items={serviceCards} alt
  cta={isLive(routes.servicesHub()) ? { href: routes.servicesHub(), label: c.servicesBlock.ctaLabel ?? 'See All Services' } : null} />
<SymptomPicker heading={c.picker?.h2} intro={c.picker?.intro} />
<Cards heading={c.brandsBlock?.h2} intro={c.brandsBlock?.intro} items={c.brandsBlock ? brandCards : []} cols="grid-3" />
<Team intro={c.team?.intro} alt />
<Prose sections={c.sections} />
<Video heading={c.video?.h2} intro={c.video?.intro} alt />
<Gallery heading={c.gallery?.h2} intro={c.gallery?.intro} />
<Reviews heading={c.reviews?.heading} intro={c.reviews?.intro} cta={isLive(routes.reviews()) ? { href: routes.reviews(), label: 'Read More Reviews' } : null} />
<Credentials heading={c.credentials?.h2} intro={c.credentials?.intro} alt />
<Partners heading={c.partners?.h2} intro={c.partners?.intro} />
<ClubBand />
<BrandList alt />
<Tiles heading={c.areasBlock.h2} intro={c.areasBlock.intro} items={cityTiles}
  cta={isLive(routes.areasHub()) ? { href: routes.areasHub(), label: c.areasBlock.ctaLabel ?? 'See Our Service Area' } : null} />
<MapEmbed />
<Cards heading={c.latestPosts?.h2} items={c.latestPosts ? posts : []} alt cols="grid-3"
  cta={isLive(routes.blogHub()) ? { href: routes.blogHub(), label: 'Visit the Blog' } : null} />
<Faq faq={c.faq} heading={c.faqHeading} closing={c.faqClosing} cta={{ href: faqCtaPath(), label: 'See All FAQs' }} />
<FinalCta closing={c.closing} />
